<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!--
    Every package here is justified in specs/001-foundation-skeleton/research.md with its
    licence. Adding one without that justification is a constitution Principle XI
    violation, not a style preference.
  -->
  <ItemGroup Label="Data access (constitution: EF Core + Npgsql only)">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Npgsql.OpenTelemetry" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup Label="Runtime extensions">
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.12" />
    <!-- 013 research MV-20: binds the S3 and Azure Blob storage sections. MIT. -->
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.12" />
  </ItemGroup>

  <!--
    Image processing (specs/013-media-library-variants/research.md MV-09, MV-22).
    NetVips (MIT) binds libvips; the NetVips.Native.* packages carry libvips and its codecs
    (LGPL-3.0-or-later plus permissive licences), loaded dynamically and shipped unmodified,
    which is what makes them redistributable with an MIT product. Listed in
    THIRD-PARTY-NOTICES.md. Rejected: ImageSharp (Split License), SkiaSharp (no AVIF),
    Magick.NET (size, decoder history). All four natives must stay on one libvips version.
  -->
  <ItemGroup Label="Image processing (013 MV-09)">
    <PackageVersion Include="NetVips" Version="3.2.0" />
    <PackageVersion Include="NetVips.Native.linux-musl-x64" Version="8.18.7" />
    <PackageVersion Include="NetVips.Native.linux-musl-arm64" Version="8.18.7" />
    <PackageVersion Include="NetVips.Native.linux-x64" Version="8.18.7" />
    <PackageVersion Include="NetVips.Native.win-x64" Version="8.18.7" />
  </ItemGroup>

  <!--
    Remote storage providers (013 research MV-18, MV-19, MV-22). Selected only when the
    operator sets Storage:Provider; a default install makes no call through them.
    AWSSDK.S3: Apache-2.0 (rejected: the MinIO client, no IRSA/instance-profile chain).
    Azure.Storage.Blobs and Azure.Identity: MIT (managed and workload identity, FR-032).
  -->
  <ItemGroup Label="Remote storage (013 MV-18, MV-19)">
    <PackageVersion Include="AWSSDK.S3" Version="4.0.103.4" />
    <PackageVersion Include="Azure.Storage.Blobs" Version="12.29.2" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
  </ItemGroup>

  <ItemGroup Label="Observability (FR-031, FR-031a, FR-031b)">
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.19.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.19.0" />
  </ItemGroup>

  <ItemGroup Label="Build-time analyzers (FR-013a / D-07)">
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
  </ItemGroup>

  <ItemGroup Label="Test infrastructure (Principle X: no in-memory providers)">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <!-- 013 MV-25: each optional storage provider has its own suite (Principle X). MIT. -->
    <PackageVersion Include="Testcontainers.Minio" Version="4.15.0" />
    <PackageVersion Include="Testcontainers.Azurite" Version="4.15.0" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="Xunit.SkippableFact" Version="1.5.85" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>

</Project>
