<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Shared\QuickBuilder.Shared.Kernel\QuickBuilder.Shared.Kernel.csproj" />
    <ProjectReference Include="..\..\src\Shared\QuickBuilder.Shared.Infrastructure\QuickBuilder.Shared.Infrastructure.csproj" />
    <!-- Domain invariants are internal to the module; InternalsVisibleTo grants access. -->
    <ProjectReference Include="..\..\src\Modules\Sites\QuickBuilder.Sites\QuickBuilder.Sites.csproj" />
    <ProjectReference Include="..\..\src\Modules\Identity\QuickBuilder.Identity\QuickBuilder.Identity.csproj" />
    <ProjectReference Include="..\..\src\Modules\Identity\QuickBuilder.Identity.Contracts\QuickBuilder.Identity.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Modules\Media\QuickBuilder.Media\QuickBuilder.Media.csproj" />
    <ProjectReference Include="..\..\src\Modules\Media\QuickBuilder.Media.Contracts\QuickBuilder.Media.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Modules\Pages\QuickBuilder.Pages\QuickBuilder.Pages.csproj" />
    <ProjectReference Include="..\..\src\Modules\Pages\QuickBuilder.Pages.Contracts\QuickBuilder.Pages.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Modules\Editor\QuickBuilder.Editor\QuickBuilder.Editor.csproj" />
    <ProjectReference Include="..\..\src\Modules\Editor\QuickBuilder.Editor.Contracts\QuickBuilder.Editor.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Modules\Cms\QuickBuilder.Cms\QuickBuilder.Cms.csproj" />
    <ProjectReference Include="..\..\src\Modules\Cms\QuickBuilder.Cms.Contracts\QuickBuilder.Cms.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Modules\Rendering\QuickBuilder.Rendering\QuickBuilder.Rendering.csproj" />
    <ProjectReference Include="..\..\src\Modules\Rendering\QuickBuilder.Rendering.Contracts\QuickBuilder.Rendering.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Modules\Forms\QuickBuilder.Forms\QuickBuilder.Forms.csproj" />
    <ProjectReference Include="..\..\src\Modules\Forms\QuickBuilder.Forms.Contracts\QuickBuilder.Forms.Contracts.csproj" />
    <!--
      019 RL-22: the release tool's rules are unit-tested here. Aliased because the tool
      compiles in Shared.Infrastructure's SemanticVersion too; tests reach it through
      `extern alias releasetool`.
    -->
    <ProjectReference Include="..\..\tools\QuickBuilder.Release\QuickBuilder.Release.csproj" Aliases="releasetool" />
    <!-- 026 OD-04: the docs tool's catalog, lint checks and snippet runner. -->
    <ProjectReference Include="..\..\tools\QuickBuilder.Docs\QuickBuilder.Docs.csproj" />
  </ItemGroup>

  <!-- 013 T045: images generated at test time (tests/fixtures/media/ImageFixtures.cs). -->
  <ItemGroup>
    <Compile Include="../fixtures/media/ImageFixtures.cs" Link="Fixtures/ImageFixtures.cs" />
  </ItemGroup>

  <!--
    019 T017, T018: the release gate's pure helpers. They live with the gate in SmokeTests,
    which CI never runs on pull requests, so their unit tests compile them in here.
  -->
  <ItemGroup>
    <Compile Include="../QuickBuilder.SmokeTests/Release/VisibleForm.cs" Link="Release/Gate/VisibleForm.cs" />
    <Compile Include="../QuickBuilder.SmokeTests/Release/Expectations.cs" Link="Release/Gate/Expectations.cs" />
    <Compile Include="../QuickBuilder.SmokeTests/Release/ExpectationComparer.cs" Link="Release/Gate/ExpectationComparer.cs" />
    <Compile Include="../QuickBuilder.SmokeTests/Release/VisibleChangeAllowList.cs" Link="Release/Gate/VisibleChangeAllowList.cs" />
  </ItemGroup>

</Project>