{
  "$comment": "Submitted values against one field's rules (018 research FS-08; public-forms.md §4). Each case gives a field (as in a form node) and the values submitted for it (the f.<id> key, repeated for checkboxes); 'expect' is the error code (null when the values pass) and the values as stored after normalising. Normalising: CR LF and CR become LF (no Unicode normalisation: the server runs with invariant globalization, and browsers send composed text); single-line types are trimmed and their line breaks become spaces; multi-line text loses trailing whitespace only; empty values count as missing. Checks per field, first failure wins: required, then the type's format (email, phone, number, date, choice), then length, range or count. Shared by tests/QuickBuilder.UnitTests/Forms/FormValueRulesTests.cs, src/admin/tests/editor/formRules.spec.ts and src/admin/tests/rendering/formScript.spec.ts. In values, ${Na} stands for the letter a repeated N times; every consumer expands it before use.",
  "cases": [
    { "name": "optional text left empty", "field": { "id": "a00000000001", "type": "text", "label": "Name" }, "values": [], "expect": { "code": null, "values": [] } },
    { "name": "optional text sent empty", "field": { "id": "a00000000001", "type": "text", "label": "Name" }, "values": ["   "], "expect": { "code": null, "values": [] } },
    { "name": "required text missing", "field": { "id": "a00000000001", "type": "text", "label": "Name", "required": true }, "values": [], "expect": { "code": "required", "values": [] } },
    { "name": "required text only spaces", "field": { "id": "a00000000001", "type": "text", "label": "Name", "required": true }, "values": [" \t "], "expect": { "code": "required", "values": [] } },
    { "name": "text trimmed", "field": { "id": "a00000000001", "type": "text", "label": "Name", "required": true }, "values": ["  Jane Doe  "], "expect": { "code": null, "values": ["Jane Doe"] } },
    { "name": "single-line text loses line breaks", "field": { "id": "a00000000001", "type": "text", "label": "Name" }, "values": ["Jane\r\nDoe"], "expect": { "code": null, "values": ["Jane Doe"] } },
    { "name": "only the first of repeated values counts", "field": { "id": "a00000000001", "type": "text", "label": "Name" }, "values": ["First", "Second"], "expect": { "code": null, "values": ["First"] } },
    { "name": "text too short", "field": { "id": "a00000000001", "type": "text", "label": "Name", "minLength": 3 }, "values": ["Jo"], "expect": { "code": "too_short", "values": ["Jo"] } },
    { "name": "text length counts code points", "field": { "id": "a00000000001", "type": "text", "label": "Name", "maxLength": 3 }, "values": ["😀😀😀"], "expect": { "code": null, "values": ["😀😀😀"] } },
    { "name": "text too long for its own maximum", "field": { "id": "a00000000001", "type": "text", "label": "Name", "maxLength": 3 }, "values": ["Jane"], "expect": { "code": "too_long", "values": ["Jane"] } },
    { "name": "text too long for the default maximum", "field": { "id": "a00000000001", "type": "text", "label": "Name" }, "values": ["${501a}"], "expect": { "code": "too_long", "values": ["${501a}"] } },
    { "name": "text at the default maximum", "field": { "id": "a00000000001", "type": "text", "label": "Name" }, "values": ["${500a}"], "expect": { "code": null, "values": ["${500a}"] } },
    { "name": "multi-line keeps inner breaks and leading space", "field": { "id": "a00000000002", "type": "textarea", "label": "Message" }, "values": ["  Hello\r\n\r\nWorld \n "], "expect": { "code": null, "values": ["  Hello\n\nWorld"] } },
    { "name": "multi-line too long", "field": { "id": "a00000000002", "type": "textarea", "label": "Message", "maxLength": 5 }, "values": ["Hello!"], "expect": { "code": "too_long", "values": ["Hello!"] } },
    { "name": "multi-line at the default maximum", "field": { "id": "a00000000002", "type": "textarea", "label": "Message" }, "values": ["${10000a}"], "expect": { "code": null, "values": ["${10000a}"] } },
    { "name": "email valid, case kept", "field": { "id": "a00000000003", "type": "email", "label": "Email", "required": true }, "values": [" Jane.Doe@Example.COM "], "expect": { "code": null, "values": ["Jane.Doe@Example.COM"] } },
    { "name": "email without domain", "field": { "id": "a00000000003", "type": "email", "label": "Email" }, "values": ["jane@"], "expect": { "code": "email", "values": ["jane@"] } },
    { "name": "email without a dot in the domain", "field": { "id": "a00000000003", "type": "email", "label": "Email" }, "values": ["jane@localhost"], "expect": { "code": "email", "values": ["jane@localhost"] } },
    { "name": "email with two at signs", "field": { "id": "a00000000003", "type": "email", "label": "Email" }, "values": ["jane@doe@example.com"], "expect": { "code": "email", "values": ["jane@doe@example.com"] } },
    { "name": "email with a space", "field": { "id": "a00000000003", "type": "email", "label": "Email" }, "values": ["jane doe@example.com"], "expect": { "code": "email", "values": ["jane doe@example.com"] } },
    { "name": "email over 254 characters", "field": { "id": "a00000000003", "type": "email", "label": "Email" }, "values": ["${245a}@example.com"], "expect": { "code": "email", "values": ["${245a}@example.com"] } },
    { "name": "email at 254 characters", "field": { "id": "a00000000003", "type": "email", "label": "Email" }, "values": ["${242a}@example.com"], "expect": { "code": null, "values": ["${242a}@example.com"] } },
    { "name": "email too short for its minimum", "field": { "id": "a00000000003", "type": "email", "label": "Email", "minLength": 20 }, "values": ["a@b.co"], "expect": { "code": "too_short", "values": ["a@b.co"] } },
    { "name": "phone with spaces and symbols", "field": { "id": "a00000000004", "type": "phone", "label": "Phone" }, "values": ["+84 (28) 3822-1234"], "expect": { "code": null, "values": ["+84 (28) 3822-1234"] } },
    { "name": "phone with letters", "field": { "id": "a00000000004", "type": "phone", "label": "Phone" }, "values": ["call me"], "expect": { "code": "phone", "values": ["call me"] } },
    { "name": "phone without digits", "field": { "id": "a00000000004", "type": "phone", "label": "Phone" }, "values": ["+ ( ) -"], "expect": { "code": "phone", "values": ["+ ( ) -"] } },
    { "name": "number decimal", "field": { "id": "a00000000005", "type": "number", "label": "Amount" }, "values": [" 12.50 "], "expect": { "code": null, "values": ["12.50"] } },
    { "name": "number negative", "field": { "id": "a00000000005", "type": "number", "label": "Amount" }, "values": ["-3"], "expect": { "code": null, "values": ["-3"] } },
    { "name": "number with a comma", "field": { "id": "a00000000005", "type": "number", "label": "Amount" }, "values": ["12,5"], "expect": { "code": "number", "values": ["12,5"] } },
    { "name": "number written as words", "field": { "id": "a00000000005", "type": "number", "label": "Amount" }, "values": ["twelve"], "expect": { "code": "number", "values": ["twelve"] } },
    { "name": "number with an exponent", "field": { "id": "a00000000005", "type": "number", "label": "Amount" }, "values": ["1e3"], "expect": { "code": "number", "values": ["1e3"] } },
    { "name": "number not whole", "field": { "id": "a00000000005", "type": "number", "label": "Guests", "wholeNumber": true }, "values": ["2.5"], "expect": { "code": "whole", "values": ["2.5"] } },
    { "name": "number whole with zero decimals", "field": { "id": "a00000000005", "type": "number", "label": "Guests", "wholeNumber": true }, "values": ["2.0"], "expect": { "code": null, "values": ["2.0"] } },
    { "name": "number below the minimum", "field": { "id": "a00000000005", "type": "number", "label": "Guests", "min": 1 }, "values": ["0"], "expect": { "code": "too_small", "values": ["0"] } },
    { "name": "number above the maximum", "field": { "id": "a00000000005", "type": "number", "label": "Guests", "max": 12 }, "values": ["12.01"], "expect": { "code": "too_large", "values": ["12.01"] } },
    { "name": "number at the bounds", "field": { "id": "a00000000005", "type": "number", "label": "Guests", "min": 1, "max": 12 }, "values": ["12"], "expect": { "code": null, "values": ["12"] } },
    { "name": "date valid", "field": { "id": "a00000000006", "type": "date", "label": "Day" }, "values": ["2026-02-28"], "expect": { "code": null, "values": ["2026-02-28"] } },
    { "name": "date that does not exist", "field": { "id": "a00000000006", "type": "date", "label": "Day" }, "values": ["2026-02-30"], "expect": { "code": "date", "values": ["2026-02-30"] } },
    { "name": "date in another format", "field": { "id": "a00000000006", "type": "date", "label": "Day" }, "values": ["28/02/2026"], "expect": { "code": "date", "values": ["28/02/2026"] } },
    { "name": "date too early", "field": { "id": "a00000000006", "type": "date", "label": "Day", "earliest": "2026-03-01" }, "values": ["2026-02-28"], "expect": { "code": "too_early", "values": ["2026-02-28"] } },
    { "name": "date too late", "field": { "id": "a00000000006", "type": "date", "label": "Day", "latest": "2026-03-01" }, "values": ["2026-03-02"], "expect": { "code": "too_late", "values": ["2026-03-02"] } },
    { "name": "date on the earliest day", "field": { "id": "a00000000006", "type": "date", "label": "Day", "earliest": "2026-03-01", "latest": "2026-03-01" }, "values": ["2026-03-01"], "expect": { "code": null, "values": ["2026-03-01"] } },
    { "name": "select one of its options", "field": { "id": "a00000000007", "type": "select", "label": "Topic", "options": [{ "value": "sales", "label": "Sales" }, { "value": "support", "label": "Support" }] }, "values": ["support"], "expect": { "code": null, "values": ["support"] } },
    { "name": "select something else", "field": { "id": "a00000000007", "type": "select", "label": "Topic", "options": [{ "value": "sales", "label": "Sales" }] }, "values": ["hacked"], "expect": { "code": "choice", "values": ["hacked"] } },
    { "name": "select matches the value exactly", "field": { "id": "a00000000007", "type": "select", "label": "Topic", "options": [{ "value": "sales", "label": "Sales" }] }, "values": ["Sales"], "expect": { "code": "choice", "values": ["Sales"] } },
    { "name": "select the empty choice of a required field", "field": { "id": "a00000000007", "type": "select", "label": "Topic", "required": true, "options": [{ "value": "sales", "label": "Sales" }] }, "values": [""], "expect": { "code": "required", "values": [] } },
    { "name": "radio required missing", "field": { "id": "a00000000008", "type": "radio", "label": "Contact by", "required": true, "options": [{ "value": "email", "label": "Email" }] }, "values": [], "expect": { "code": "required", "values": [] } },
    { "name": "checkboxes several, kept in option order, repeats dropped", "field": { "id": "a00000000009", "type": "checkboxes", "label": "Interests", "options": [{ "value": "web", "label": "Web" }, { "value": "seo", "label": "Search" }, { "value": "host", "label": "Hosting" }] }, "values": ["host", "web", "host"], "expect": { "code": null, "values": ["web", "host"] } },
    { "name": "checkboxes one outside the options", "field": { "id": "a00000000009", "type": "checkboxes", "label": "Interests", "options": [{ "value": "web", "label": "Web" }] }, "values": ["web", "x"], "expect": { "code": "choice", "values": ["web", "x"] } },
    { "name": "checkboxes too few", "field": { "id": "a00000000009", "type": "checkboxes", "label": "Interests", "minSelected": 2, "options": [{ "value": "web", "label": "Web" }, { "value": "seo", "label": "Search" }] }, "values": ["web"], "expect": { "code": "too_few", "values": ["web"] } },
    { "name": "checkboxes too many", "field": { "id": "a00000000009", "type": "checkboxes", "label": "Interests", "maxSelected": 1, "options": [{ "value": "web", "label": "Web" }, { "value": "seo", "label": "Search" }] }, "values": ["web", "seo"], "expect": { "code": "too_many", "values": ["web", "seo"] } },
    { "name": "checkboxes none, optional, with a minimum", "field": { "id": "a00000000009", "type": "checkboxes", "label": "Interests", "minSelected": 2, "options": [{ "value": "web", "label": "Web" }, { "value": "seo", "label": "Search" }] }, "values": [], "expect": { "code": null, "values": [] } },
    { "name": "checkboxes none, required", "field": { "id": "a00000000009", "type": "checkboxes", "label": "Interests", "required": true, "options": [{ "value": "web", "label": "Web" }] }, "values": [], "expect": { "code": "required", "values": [] } },
    { "name": "checkbox ticked", "field": { "id": "a00000000010", "type": "checkbox", "label": "Newsletter" }, "values": ["yes"], "expect": { "code": null, "values": ["yes"] } },
    { "name": "checkbox ticked with any value", "field": { "id": "a00000000010", "type": "checkbox", "label": "Newsletter" }, "values": ["on"], "expect": { "code": null, "values": ["yes"] } },
    { "name": "checkbox not ticked", "field": { "id": "a00000000010", "type": "checkbox", "label": "Newsletter" }, "values": [], "expect": { "code": null, "values": [] } },
    { "name": "consent required by default", "field": { "id": "a00000000011", "type": "consent", "label": "Consent", "statement": "I agree." }, "values": [], "expect": { "code": "required", "values": [] } },
    { "name": "consent made optional", "field": { "id": "a00000000011", "type": "consent", "label": "Consent", "statement": "I agree.", "required": false }, "values": [], "expect": { "code": null, "values": [] } },
    { "name": "consent given", "field": { "id": "a00000000011", "type": "consent", "label": "Consent", "statement": "I agree." }, "values": ["yes"], "expect": { "code": null, "values": ["yes"] } }
  ]
}
