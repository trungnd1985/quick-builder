# Keep the build context small and the image free of host-local state.
**/bin/
**/obj/
**/node_modules/
**/dist/
**/.vs/
**/.vscode/
**/.idea/
**/TestResults/
**/coverage/
# 025: the browser suite and its run output are not build inputs.
tests/e2e/

.git/
.github/
specs/
docs/
# 010: the page schema is a build input (embedded by Pages.Contracts), not documentation.
!docs/contracts/

Dockerfile*
.dockerignore
docker-compose*.yml

# Never let host-local configuration or secrets into the image (FR-038).
**/*.user
**/appsettings.Development.json
**/appsettings.Local.json
**/.env
**/.env.*
**/*.log

.DS_Store
Thumbs.db
