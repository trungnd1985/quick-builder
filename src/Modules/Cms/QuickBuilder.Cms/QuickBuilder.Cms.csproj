<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Cms module: per-site collections, their schemas and schema history, and the item
    store that schema changes migrate (specs/014-cms-collections-schema). Everything is
    internal apart from the registration entry point and the controllers, mirroring
    QuickBuilder.Pages.

    It validates rich text values against the page schema through Pages.Contracts, tells
    images from documents through Media.Contracts, and names sites and users through
    Sites.Contracts and Identity.Contracts — never through another module's implementation.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Using Include="Microsoft.AspNetCore.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference
      Include="..\..\..\Shared\QuickBuilder.Shared.Kernel\QuickBuilder.Shared.Kernel.csproj" />
    <ProjectReference
      Include="..\..\..\Shared\QuickBuilder.Shared.Infrastructure\QuickBuilder.Shared.Infrastructure.csproj" />
    <ProjectReference Include="..\QuickBuilder.Cms.Contracts\QuickBuilder.Cms.Contracts.csproj" />
    <ProjectReference
      Include="..\..\Pages\QuickBuilder.Pages.Contracts\QuickBuilder.Pages.Contracts.csproj" />
    <ProjectReference
      Include="..\..\Media\QuickBuilder.Media.Contracts\QuickBuilder.Media.Contracts.csproj" />
    <!-- IEditingLocks, to fence item draft saves (023 research CE-07, CE-21). -->
    <ProjectReference
      Include="..\..\Editor\QuickBuilder.Editor.Contracts\QuickBuilder.Editor.Contracts.csproj" />
    <ProjectReference
      Include="..\..\Sites\QuickBuilder.Sites.Contracts\QuickBuilder.Sites.Contracts.csproj" />
    <ProjectReference
      Include="..\..\Identity\QuickBuilder.Identity.Contracts\QuickBuilder.Identity.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="QuickBuilder.IntegrationTests" />
    <InternalsVisibleTo Include="QuickBuilder.UnitTests" />
    <InternalsVisibleTo Include="QuickBuilder.ArchitectureTests" />
  </ItemGroup>

</Project>
