<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Identity module: accounts, sessions, role grants, setup, and the enforcement half
    of authorization (research R-05). Everything is internal apart from the registration
    entry point and the controllers, mirroring QuickBuilder.Sites.

    It references Sites.Contracts — never the Sites implementation — to validate the site
    named in a grant (data-model.md, role_grants).
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Using Include="Microsoft.AspNetCore.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Shared\QuickBuilder.Shared.Kernel\QuickBuilder.Shared.Kernel.csproj" />
    <ProjectReference Include="..\..\..\Shared\QuickBuilder.Shared.Infrastructure\QuickBuilder.Shared.Infrastructure.csproj" />
    <ProjectReference Include="..\QuickBuilder.Identity.Contracts\QuickBuilder.Identity.Contracts.csproj" />
    <ProjectReference Include="..\..\Sites\QuickBuilder.Sites.Contracts\QuickBuilder.Sites.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- FR-008 / research R-15: the offline common-password list, filtered to 12+ characters. -->
  <ItemGroup>
    <EmbeddedResource Include="Infrastructure\Security\Resources\common-passwords-12plus.txt"
                      LogicalName="QuickBuilder.Identity.CommonPasswords" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="QuickBuilder.IntegrationTests" />
    <InternalsVisibleTo Include="QuickBuilder.UnitTests" />
    <InternalsVisibleTo Include="QuickBuilder.ArchitectureTests" />
  </ItemGroup>

</Project>
