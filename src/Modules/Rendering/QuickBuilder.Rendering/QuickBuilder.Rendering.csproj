<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Rendering module (specs/012-publishing-rendering, research PR-01): published pages
    as server-side HTML, the output cache, the block stylesheet and the not-found page. It
    owns no tables. It reads published data only through other modules' Contracts readers,
    which run on read-only connections (PR-06), so the public path cannot write content.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Using Include="Microsoft.AspNetCore.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Shared\QuickBuilder.Shared.Kernel\QuickBuilder.Shared.Kernel.csproj" />
    <ProjectReference Include="..\..\..\Shared\QuickBuilder.Shared.Infrastructure\QuickBuilder.Shared.Infrastructure.csproj" />
    <ProjectReference Include="..\QuickBuilder.Rendering.Contracts\QuickBuilder.Rendering.Contracts.csproj" />
    <ProjectReference Include="..\..\Sites\QuickBuilder.Sites.Contracts\QuickBuilder.Sites.Contracts.csproj" />
    <ProjectReference Include="..\..\Identity\QuickBuilder.Identity.Contracts\QuickBuilder.Identity.Contracts.csproj" />
    <ProjectReference Include="..\..\Pages\QuickBuilder.Pages.Contracts\QuickBuilder.Pages.Contracts.csproj" />
    <ProjectReference Include="..\..\Editor\QuickBuilder.Editor.Contracts\QuickBuilder.Editor.Contracts.csproj" />
    <ProjectReference Include="..\..\Media\QuickBuilder.Media.Contracts\QuickBuilder.Media.Contracts.csproj" />
    <!-- 016 research TB-08: published items, read only through IPublishedItemReader. -->
    <ProjectReference Include="..\..\Cms\QuickBuilder.Cms.Contracts\QuickBuilder.Cms.Contracts.csproj" />
  </ItemGroup>

  <!--
    Research PR-10: the editor's block stylesheet is the one stylesheet for the canvas and
    the published page. It is embedded from where the admin keeps it, never copied, so the
    two cannot drift. The Dockerfile's build stage copies this one file for the same reason.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\..\admin\src\editor\blocks\blocks.css"
                      LogicalName="QuickBuilder.Rendering.blocks.css" />
    <EmbeddedResource Include="Resources\public-texts\*.json"
                      LogicalName="QuickBuilder.Rendering.PublicTexts.%(Filename)%(Extension)" />
    <!-- 016 research TB-09: how bound dates and numbers read, shared with the editor. -->
    <EmbeddedResource Include="..\..\..\..\docs\contracts\binding-expression\formats.json"
                      LogicalName="QuickBuilder.Rendering.BindingFormats.json" />
    <!-- 018 research FS-10: the form script, admitted by its hash; the admin's tests read the same file. -->
    <EmbeddedResource Include="Resources\form-script.js"
                      LogicalName="QuickBuilder.Rendering.form-script.js" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="QuickBuilder.IntegrationTests" />
    <InternalsVisibleTo Include="QuickBuilder.UnitTests" />
    <InternalsVisibleTo Include="QuickBuilder.ArchitectureTests" />
  </ItemGroup>

  <!-- 017 research SE-19: the structured data types are the contract's own file, so the
       renderer and the editor can never disagree about them. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\..\..\docs\contracts\structured-data\types.json"
                      LogicalName="QuickBuilder.Rendering.StructuredData.types.json" />
  </ItemGroup>

</Project>
