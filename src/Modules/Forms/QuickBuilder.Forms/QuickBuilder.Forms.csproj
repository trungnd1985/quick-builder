<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Forms module: form submissions from site visitors, their notifications, spam
    protection and retention (specs/018-forms-submissions, research FS-01). Everything is
    internal apart from the registration entry point and the controllers.

    It reads published forms through Pages.Contracts, asks Rendering.Contracts for the page
    shown when a submission without scripts is refused, and names sites and users through
    Sites.Contracts and Identity.Contracts — never through another module's implementation.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Using Include="Microsoft.AspNetCore.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Shared\QuickBuilder.Shared.Kernel\QuickBuilder.Shared.Kernel.csproj" />
    <ProjectReference Include="..\..\..\Shared\QuickBuilder.Shared.Infrastructure\QuickBuilder.Shared.Infrastructure.csproj" />
    <ProjectReference Include="..\QuickBuilder.Forms.Contracts\QuickBuilder.Forms.Contracts.csproj" />
    <ProjectReference Include="..\..\Pages\QuickBuilder.Pages.Contracts\QuickBuilder.Pages.Contracts.csproj" />
    <ProjectReference Include="..\..\Rendering\QuickBuilder.Rendering.Contracts\QuickBuilder.Rendering.Contracts.csproj" />
    <ProjectReference Include="..\..\Sites\QuickBuilder.Sites.Contracts\QuickBuilder.Sites.Contracts.csproj" />
    <ProjectReference Include="..\..\Identity\QuickBuilder.Identity.Contracts\QuickBuilder.Identity.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="QuickBuilder.IntegrationTests" />
    <InternalsVisibleTo Include="QuickBuilder.UnitTests" />
    <InternalsVisibleTo Include="QuickBuilder.ArchitectureTests" />
  </ItemGroup>

</Project>
