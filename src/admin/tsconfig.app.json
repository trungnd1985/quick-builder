{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "resolveJsonModule": true,
    /* 011 ED-08: the contracts are imported from docs/contracts/, where they live. */
    "paths": { "@contracts/*": ["../../docs/contracts/*"] },

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue", "../../docs/contracts/page-schema/v1.schema.json", "../../docs/contracts/design-tokens/examples/valid/default.json"]
}
