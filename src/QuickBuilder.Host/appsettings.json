{
  "ConnectionStrings": {
    "//": "Required. No default — PostgreSQL is the one external dependency and there is no sensible fallback. Override with ConnectionStrings__Default.",
    "Default": ""
  },

  "Database": {
    "AutoMigrate": true,
    "ConnectionRetryTimeout": "00:02:00",
    "ConnectionRetryDelay": "00:00:02",
    "MigrationTimeout": "00:05:00"
  },

  "Hosting": {
    "BasePath": "",
    "//": "Empty KnownProxies/KnownNetworks means no forwarded header is trusted. Name your proxy before putting one in front.",
    "KnownProxies": [],
    "KnownNetworks": []
  },

  "Admin": {
    "PathPrefix": "/admin"
  },

  "Outbox": {
    "Enabled": true,
    "PollInterval": "00:00:05",
    "BatchSize": 50,
    "HandlerTimeout": "00:00:30",
    "MaxAttempts": 5,
    "RetentionPeriod": "7.00:00:00"
  },

  "Telemetry": {
    "ServiceName": "quickbuilder",
    "//": "Empty OtlpEndpoint means no exporter is registered and nothing leaves the process.",
    "OtlpEndpoint": ""
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "QuickBuilder": "Information"
      }
    }
  },

  "AllowedHosts": "*"
}
