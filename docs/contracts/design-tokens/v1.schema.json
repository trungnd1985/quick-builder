{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quickbuilder.dev/contracts/design-tokens/v1.schema.json",
  "title": "QuickBuilder design token set, version 1",
  "type": "object",
  "required": [
    "schemaVersion",
    "colors",
    "typography",
    "spacing"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "colors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "$ref": "#/$defs/color"
      }
    },
    "typography": {
      "type": "object",
      "required": [
        "headingFont",
        "bodyFont",
        "baseSizePx",
        "sizes"
      ],
      "additionalProperties": false,
      "properties": {
        "headingFont": {
          "$ref": "#/$defs/fontStack"
        },
        "bodyFont": {
          "$ref": "#/$defs/fontStack"
        },
        "baseSizePx": {
          "type": "integer",
          "minimum": 12,
          "maximum": 24
        },
        "sizes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/textSize"
          }
        }
      }
    },
    "spacing": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/space"
      }
    },
    "contentWidths": {
      "description": "Optional. A set without it uses the default set's widths (design-tokens.md §2).",
      "type": "object",
      "required": [
        "narrow",
        "normal",
        "wide"
      ],
      "additionalProperties": false,
      "properties": {
        "narrow": {
          "$ref": "#/$defs/contentWidth"
        },
        "normal": {
          "$ref": "#/$defs/contentWidth"
        },
        "wide": {
          "$ref": "#/$defs/contentWidth"
        }
      }
    }
  },
  "$defs": {
    "tokenId": {
      "description": "Unique across colors, typography.sizes and spacing. Never changes once created.",
      "type": "string",
      "pattern": "^[a-z0-9-]{1,40}$"
    },
    "tokenName": {
      "description": "Display only. Unique within its list, ignoring case.",
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "fontStack": {
      "description": "A named system font stack (design-tokens.md §3).",
      "enum": [
        "system-ui",
        "transitional",
        "old-style",
        "humanist",
        "geometric-humanist",
        "classical-humanist",
        "neo-grotesque",
        "monospace-slab",
        "monospace-code",
        "industrial",
        "rounded-sans",
        "slab-serif",
        "antique",
        "didone",
        "handwritten"
      ]
    },
    "color": {
      "type": "object",
      "required": [
        "id",
        "name",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/tokenId"
        },
        "name": {
          "$ref": "#/$defs/tokenName"
        },
        "value": {
          "type": "string",
          "pattern": "^#[0-9a-f]{6}([0-9a-f]{2})?$"
        }
      }
    },
    "textSize": {
      "type": "object",
      "required": [
        "id",
        "name",
        "rem"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/tokenId"
        },
        "name": {
          "$ref": "#/$defs/tokenName"
        },
        "rem": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 6
        }
      }
    },
    "space": {
      "type": "object",
      "required": [
        "id",
        "name",
        "rem"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/tokenId"
        },
        "name": {
          "$ref": "#/$defs/tokenName"
        },
        "rem": {
          "type": "number",
          "minimum": 0,
          "maximum": 16
        }
      }
    },
    "contentWidth": {
      "description": "A content width in CSS pixels.",
      "type": "integer",
      "minimum": 320,
      "maximum": 2560
    }
  }
}
