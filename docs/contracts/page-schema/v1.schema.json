{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quickbuilder.dev/contracts/page-schema/v1.schema.json",
  "title": "QuickBuilder content document, version 1",
  "type": "object",
  "required": [
    "schemaVersion",
    "root"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "root": {
      "$ref": "#/$defs/root"
    }
  },
  "$defs": {
    "nodeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "root": {
      "type": "object",
      "required": [
        "id",
        "type",
        "props",
        "children"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "type": {
          "const": "root"
        },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rootChild"
          }
        }
      }
    },
    "rootChild": {
      "description": "What may sit directly under the document root.",
      "oneOf": [
        {
          "$ref": "#/$defs/section"
        },
        {
          "$ref": "#/$defs/component-ref"
        }
      ]
    },
    "contentChild": {
      "description": "What may sit inside a section or a container.",
      "oneOf": [
        {
          "$ref": "#/$defs/container"
        },
        {
          "$ref": "#/$defs/heading"
        },
        {
          "$ref": "#/$defs/text"
        },
        {
          "$ref": "#/$defs/rich-text"
        },
        {
          "$ref": "#/$defs/image"
        },
        {
          "$ref": "#/$defs/button"
        },
        {
          "$ref": "#/$defs/spacer"
        },
        {
          "$ref": "#/$defs/divider"
        },
        {
          "$ref": "#/$defs/embed"
        }
      ]
    },
    "noChildren": {
      "type": "array",
      "maxItems": 0
    },
    "contentChildren": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contentChild"
      }
    },
    "component-ref": {
      "type": "object",
      "required": [
        "id",
        "type",
        "props",
        "children"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "type": {
          "const": "component-ref"
        },
        "props": {
          "type": "object",
          "required": [
            "componentId"
          ],
          "additionalProperties": false,
          "properties": {
            "componentId": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "children": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "layerLabel": {
      "description": "A name for the editor's layer view. Never rendered to visitors.",
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "tokenId": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,40}$"
    },
    "colorRef": {
      "description": "A colour of the site's design tokens, by id. It may name a token that no longer exists; consumers then use the property default.",
      "type": "object",
      "required": [
        "token"
      ],
      "additionalProperties": false,
      "properties": {
        "token": {
          "$ref": "#/$defs/tokenId"
        }
      }
    },
    "spaceRef": {
      "description": "A spacing step of the site's design tokens, by id. It may name a token that no longer exists.",
      "type": "object",
      "required": [
        "token"
      ],
      "additionalProperties": false,
      "properties": {
        "token": {
          "$ref": "#/$defs/tokenId"
        }
      }
    },
    "textSizeRef": {
      "description": "A text-size step of the site's design tokens, by id. It may name a token that no longer exists.",
      "type": "object",
      "required": [
        "token"
      ],
      "additionalProperties": false,
      "properties": {
        "token": {
          "$ref": "#/$defs/tokenId"
        }
      }
    },
    "align": {
      "enum": [
        "start",
        "center",
        "end"
      ],
      "default": "start"
    },
    "link": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "pageId"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "page"
            },
            "pageId": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "href"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "url"
            },
            "href": {
              "type": "string",
              "maxLength": 2048,
              "pattern": "^(https?://[^\\u0000-\\u0020\\u007f]+|mailto:[^\\u0000-\\u0020\\u007f]+|tel:[+0-9 ().-]+)$"
            }
          }
        }
      ]
    },
    "section": {
      "type": "object",
      "required": [
        "id",
        "type",
        "props",
        "children"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "type": {
          "const": "section"
        },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "background": {
              "$ref": "#/$defs/colorRef"
            },
            "paddingY": {
              "$ref": "#/$defs/spaceRef",
              "default": {
                "token": "space-xl"
              }
            },
            "width": {
              "enum": [
                "narrow",
                "contained",
                "wide",
                "full"
              ],
              "default": "contained"
            },
            "layerLabel": {
              "$ref": "#/$defs/layerLabel"
            }
          }
        },
        "children": {
          "$ref": "#/$defs/contentChildren"
        }
      }
    },
    "container": {
      "type": "object",
      "required": [
        "id",
        "type",
        "props",
        "children"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "type": {
          "const": "container"
        },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "direction": {
              "enum": [
                "vertical",
                "horizontal"
              ],
              "default": "vertical"
            },
            "columns": {
              "enum": [
                "equal",
                "2-1",
                "1-2",
                "3-1",
                "1-3",
                "2-1-1"
              ],
              "default": "equal"
            },
            "gap": {
              "$ref": "#/$defs/spaceRef",
              "default": {
                "token": "space-md"
              }
            },
            "padding": {
              "$ref": "#/$defs/spaceRef",
              "default": {
                "token": "space-none"
              }
            },
            "align": {
              "$ref": "#/$defs/align"
            },
            "maxWidth": {
              "enum": [
                "narrow",
                "normal",
                "wide",
                "full"
              ],
              "default": "full"
            },
            "background": {
              "$ref": "#/$defs/colorRef"
            },
            "stackOnMobile": {
              "type": "boolean",
              "default": true
            },
            "layerLabel": {
              "$ref": "#/$defs/layerLabel"
            }
          }
        },
        "children": {
          "$ref": "#/$defs/contentChildren"
        }
      }
    },
    "heading": {
      "type": "object",
      "required": [
        "id",
        "type",
        "props",
        "children"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "type": {
          "const": "heading"
        },
        "props": {
          "type": "object",
          "required": [
            "text"
          ],
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string",
              "maxLength": 300,
              "pattern": "^[^\\r\\n]*$"
            },
            "level": {
              "type": "integer",
              "minimum": 1,
              "maximum": 6,
              "default": 2
            },
            "align": {
              "$ref": "#/$defs/align"
            },
            "color": {
              "$ref": "#/$defs/colorRef",
              "default": {
                "token": "color-text"
              }
            },
            "layerLabel": {
              "$ref": "#/$defs/layerLabel"
            }
          }
        },
        "children": {
          "$ref": "#/$defs/noChildren"
        }
      }
    },
    "text": {
      "type": "object",
      "required": [
        "id",
        "type",
        "props",
        "children"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "type": {
          "const": "text"
        },
        "props": {
          "type": "object",
          "required": [
            "text"
          ],
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string",
              "maxLength": 5000
            },
            "align": {
              "$ref": "#/$defs/align"
            },
            "color": {
              "$ref": "#/$defs/colorRef",
              "default": {
                "token": "color-text"
              }
            },
            "size": {
              "$ref": "#/$defs/textSizeRef",
              "default": {
                "token": "text-md"
              }
            },
            "layerLabel": {
              "$ref": "#/$defs/layerLabel"
            }
          }
        },
        "children": {
          "$ref": "#/$defs/noChildren"
        }
      }
    },
    "rich-text": {
      "type": "object",
      "required": [
        "id",
        "type",
        "props",
        "children"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "type": {
          "const": "rich-text"
        },
        "props": {
          "type": "object",
          "required": [
            "content"
          ],
          "additionalProperties": false,
          "properties": {
            "content": {
              "$ref": "#/$defs/rtDoc"
            },
            "align": {
              "$ref": "#/$defs/align"
            },
            "color": {
              "$ref": "#/$defs/colorRef",
              "default": {
                "token": "color-text"
              }
            },
            "layerLabel": {
              "$ref": "#/$defs/layerLabel"
            }
          }
        },
        "children": {
          "$ref": "#/$defs/noChildren"
        }
      }
    },
    "image": {
      "type": "object",
      "required": [
        "id",
        "type",
        "props",
        "children"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "type": {
          "const": "image"
        },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "media": {
              "type": "object",
              "required": [
                "mediaId"
              ],
              "additionalProperties": false,
              "properties": {
                "mediaId": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "alt": {
              "type": "string",
              "maxLength": 300
            },
            "decorative": {
              "type": "boolean",
              "default": false
            },
            "width": {
              "enum": [
                "full",
                "natural"
              ],
              "default": "full"
            },
            "link": {
              "$ref": "#/$defs/link"
            },
            "layerLabel": {
              "$ref": "#/$defs/layerLabel"
            }
          }
        },
        "children": {
          "$ref": "#/$defs/noChildren"
        }
      }
    },
    "button": {
      "type": "object",
      "required": [
        "id",
        "type",
        "props",
        "children"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "type": {
          "const": "button"
        },
        "props": {
          "type": "object",
          "required": [
            "label"
          ],
          "additionalProperties": false,
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "link": {
              "$ref": "#/$defs/link"
            },
            "style": {
              "enum": [
                "primary",
                "secondary",
                "outline"
              ],
              "default": "primary"
            },
            "align": {
              "$ref": "#/$defs/align"
            },
            "newTab": {
              "type": "boolean",
              "default": false
            },
            "layerLabel": {
              "$ref": "#/$defs/layerLabel"
            }
          }
        },
        "children": {
          "$ref": "#/$defs/noChildren"
        }
      }
    },
    "spacer": {
      "type": "object",
      "required": [
        "id",
        "type",
        "props",
        "children"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "type": {
          "const": "spacer"
        },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "height": {
              "$ref": "#/$defs/spaceRef",
              "default": {
                "token": "space-lg"
              }
            },
            "layerLabel": {
              "$ref": "#/$defs/layerLabel"
            }
          }
        },
        "children": {
          "$ref": "#/$defs/noChildren"
        }
      }
    },
    "divider": {
      "type": "object",
      "required": [
        "id",
        "type",
        "props",
        "children"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "type": {
          "const": "divider"
        },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "color": {
              "$ref": "#/$defs/colorRef",
              "default": {
                "token": "color-border"
              }
            },
            "thickness": {
              "enum": [
                "thin",
                "thick"
              ],
              "default": "thin"
            },
            "spacing": {
              "$ref": "#/$defs/spaceRef",
              "default": {
                "token": "space-md"
              }
            },
            "layerLabel": {
              "$ref": "#/$defs/layerLabel"
            }
          }
        },
        "children": {
          "$ref": "#/$defs/noChildren"
        }
      }
    },
    "embed": {
      "type": "object",
      "required": [
        "id",
        "type",
        "props",
        "children"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "type": {
          "const": "embed"
        },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": {
              "type": "string",
              "maxLength": 2048,
              "pattern": "^https://((www\\.)?youtube\\.com/watch\\?v=[A-Za-z0-9_-]{11}(&[^\\u0000-\\u0020\\u007f]*)?|youtu\\.be/[A-Za-z0-9_-]{11}(\\?[^\\u0000-\\u0020\\u007f]*)?|(www\\.)?vimeo\\.com/[0-9]{1,12}(\\?[^\\u0000-\\u0020\\u007f]*)?)$"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "aspectRatio": {
              "enum": [
                "16:9",
                "4:3",
                "1:1"
              ],
              "default": "16:9"
            },
            "layerLabel": {
              "$ref": "#/$defs/layerLabel"
            }
          }
        },
        "children": {
          "$ref": "#/$defs/noChildren"
        }
      }
    },
    "rtDoc": {
      "type": "object",
      "required": [
        "type",
        "content"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "doc"
        },
        "content": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/rtBlock"
          }
        }
      }
    },
    "rtBlock": {
      "oneOf": [
        {
          "$ref": "#/$defs/rtParagraph"
        },
        {
          "$ref": "#/$defs/rtHeading"
        },
        {
          "$ref": "#/$defs/rtBlockquote"
        },
        {
          "$ref": "#/$defs/rtBulletList"
        },
        {
          "$ref": "#/$defs/rtOrderedList"
        }
      ]
    },
    "rtListBlock": {
      "oneOf": [
        {
          "$ref": "#/$defs/rtParagraph"
        },
        {
          "$ref": "#/$defs/rtBulletList"
        },
        {
          "$ref": "#/$defs/rtOrderedList"
        }
      ]
    },
    "rtParagraph": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "paragraph"
        },
        "content": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/rtInline"
          }
        }
      }
    },
    "rtHeading": {
      "type": "object",
      "required": [
        "type",
        "attrs"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "heading"
        },
        "attrs": {
          "type": "object",
          "required": [
            "level"
          ],
          "additionalProperties": false,
          "properties": {
            "level": {
              "enum": [
                2,
                3,
                4
              ]
            }
          }
        },
        "content": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/rtInline"
          }
        }
      }
    },
    "rtBlockquote": {
      "type": "object",
      "required": [
        "type",
        "content"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "blockquote"
        },
        "content": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/rtListBlock"
          }
        }
      }
    },
    "rtBulletList": {
      "type": "object",
      "required": [
        "type",
        "content"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "bulletList"
        },
        "content": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/rtListItem"
          }
        }
      }
    },
    "rtOrderedList": {
      "type": "object",
      "required": [
        "type",
        "content"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "orderedList"
        },
        "content": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/rtListItem"
          }
        },
        "attrs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "start": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9999
            }
          }
        }
      }
    },
    "rtListItem": {
      "type": "object",
      "required": [
        "type",
        "content"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "listItem"
        },
        "content": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/rtListBlock"
          }
        }
      }
    },
    "rtInline": {
      "oneOf": [
        {
          "$ref": "#/$defs/rtText"
        },
        {
          "$ref": "#/$defs/rtHardBreak"
        }
      ]
    },
    "rtText": {
      "type": "object",
      "required": [
        "type",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "text"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "marks": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/rtMark"
          }
        }
      }
    },
    "rtHardBreak": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "hardBreak"
        }
      }
    },
    "rtMark": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "bold"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "italic"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "attrs"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "link"
            },
            "attrs": {
              "type": "object",
              "required": [
                "to"
              ],
              "additionalProperties": false,
              "properties": {
                "to": {
                  "$ref": "#/$defs/link"
                }
              }
            }
          }
        }
      ]
    }
  }
}
