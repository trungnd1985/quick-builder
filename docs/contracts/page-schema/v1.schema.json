{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quickbuilder.dev/contracts/page-schema/v1.schema.json",
  "title": "QuickBuilder content document, version 1",
  "type": "object",
  "required": [
    "schemaVersion",
    "root"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "bindingVersion": {
      "description": "The binding expression format version (binding-expression.md). Required when the document holds a bind or a collection-list (rule 13).",
      "const": 1
    },
    "root": {
      "$ref": "#/$defs/root"
    }
  },
  "$defs": {
    "nodeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "root": {
      "type": "object",
      "required": [
        "id",
        "type",
        "props",
        "children"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "type": {
          "const": "root"
        },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "seo": {
              "$ref": "#/$defs/seo"
            }
          }
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rootChild"
          }
        }
      }
    },
    "rootChild": {
      "description": "What may sit directly under the document root.",
      "oneOf": [
        {
          "$ref": "#/$defs/section"
        },
        {
          "$ref": "#/$defs/component-ref"
        }
      ]
    },
    "contentChild": {
      "description": "What may sit inside a section or a container.",
      "oneOf": [
        {
          "$ref": "#/$defs/container"
        },
        {
          "$ref": "#/$defs/heading"
        },
        {
          "$ref": "#/$defs/text"
        },
        {
          "$ref": "#/$defs/rich-text"
        },
        {
          "$ref": "#/$defs/image"
        },
        {
          "$ref": "#/$defs/button"
        },
        {
          "$ref": "#/$defs/spacer"
        },
        {
          "$ref": "#/$defs/divider"
        },
        {
          "$ref": "#/$defs/embed"
        },
        {
          "$ref": "#/$defs/collection-list"
        },
        {
          "$ref": "#/$defs/navigation"
        }
      ]
    },
    "listChild": {
      "description": "What may sit directly inside a collection-list: its card, then its empty state (rule 20).",
      "oneOf": [
        {
          "$ref": "#/$defs/list-card"
        },
        {
          "$ref": "#/$defs/list-empty"
        }
      ]
    },
    "noChildren": {
      "type": "array",
      "maxItems": 0
    },
    "contentChildren": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contentChild"
      }
    },
    "component-ref": {
      "type": "object",
      "required": [
        "id",
        "type",
        "props",
        "children"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "type": {
          "const": "component-ref"
        },
        "props": {
          "type": "object",
          "required": [
            "componentId"
          ],
          "additionalProperties": false,
          "properties": {
            "componentId": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "children": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "layerLabel": {
      "description": "A name for the editor's layer view. Never rendered to visitors.",
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "tokenId": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,40}$"
    },
    "colorRef": {
      "description": "A colour of the site's design tokens, by id. It may name a token that no longer exists; consumers then use the property default.",
      "type": "object",
      "required": [
        "token"
      ],
      "additionalProperties": false,
      "properties": {
        "token": {
          "$ref": "#/$defs/tokenId"
        }
      }
    },
    "spaceRef": {
      "description": "A spacing step of the site's design tokens, by id. It may name a token that no longer exists.",
      "type": "object",
      "required": [
        "token"
      ],
      "additionalProperties": false,
      "properties": {
        "token": {
          "$ref": "#/$defs/tokenId"
        }
      }
    },
    "textSizeRef": {
      "description": "A text-size step of the site's design tokens, by id. It may name a token that no longer exists.",
      "type": "object",
      "required": [
        "token"
      ],
      "additionalProperties": false,
      "properties": {
        "token": {
          "$ref": "#/$defs/tokenId"
        }
      }
    },
    "align": {
      "enum": [
        "start",
        "center",
        "end"
      ],
      "default": "start"
    },
    "link": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "pageId"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "page"
            },
            "pageId": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "href"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "url"
            },
            "href": {
              "type": "string",
              "maxLength": 2048,
              "pattern": "^(https?://[^\\u0000-\\u0020\\u007f]+|mailto:[^\\u0000-\\u0020\\u007f]+|tel:[+0-9 ().-]+)$"
            }
          }
        }
      ]
    },
    "section": {
      "type": "object",
      "required": [
        "id",
        "type",
        "props",
        "children"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "type": {
          "const": "section"
        },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "background": {
              "$ref": "#/$defs/colorRef"
            },
            "paddingY": {
              "$ref": "#/$defs/spaceRef",
              "default": {
                "token": "space-xl"
              }
            },
            "width": {
              "enum": [
                "narrow",
                "contained",
                "wide",
                "full"
              ],
              "default": "contained"
            },
            "layerLabel": {
              "$ref": "#/$defs/layerLabel"
            }
          }
        },
        "children": {
          "$ref": "#/$defs/contentChildren"
        }
      }
    },
    "container": {
      "type": "object",
      "required": [
        "id",
        "type",
        "props",
        "children"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "type": {
          "const": "container"
        },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "direction": {
              "enum": [
                "vertical",
                "horizontal"
              ],
              "default": "vertical"
            },
            "columns": {
              "enum": [
                "equal",
                "2-1",
                "1-2",
                "3-1",
                "1-3",
                "2-1-1"
              ],
              "default": "equal"
            },
            "gap": {
              "$ref": "#/$defs/spaceRef",
              "default": {
                "token": "space-md"
              }
            },
            "padding": {
              "$ref": "#/$defs/spaceRef",
              "default": {
                "token": "space-none"
              }
            },
            "align": {
              "$ref": "#/$defs/align"
            },
            "maxWidth": {
              "enum": [
                "narrow",
                "normal",
                "wide",
                "full"
              ],
              "default": "full"
            },
            "background": {
              "$ref": "#/$defs/colorRef"
            },
            "stackOnMobile": {
              "type": "boolean",
              "default": true
            },
            "layerLabel": {
              "$ref": "#/$defs/layerLabel"
            }
          }
        },
        "children": {
          "$ref": "#/$defs/contentChildren"
        }
      }
    },
    "heading": {
      "type": "object",
      "required": [
        "id",
        "type",
        "props",
        "children"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "type": {
          "const": "heading"
        },
        "props": {
          "type": "object",
          "required": [
            "text"
          ],
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string",
              "maxLength": 300,
              "pattern": "^[^\\r\\n]*$"
            },
            "level": {
              "type": "integer",
              "minimum": 1,
              "maximum": 6,
              "default": 2
            },
            "align": {
              "$ref": "#/$defs/align"
            },
            "color": {
              "$ref": "#/$defs/colorRef",
              "default": {
                "token": "color-text"
              }
            },
            "link": {
              "$ref": "#/$defs/link"
            },
            "layerLabel": {
              "$ref": "#/$defs/layerLabel"
            },
            "bind": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "text": {
                  "$ref": "#/$defs/binding"
                },
                "link": {
                  "$ref": "#/$defs/binding"
                }
              }
            }
          }
        },
        "children": {
          "$ref": "#/$defs/noChildren"
        }
      }
    },
    "text": {
      "type": "object",
      "required": [
        "id",
        "type",
        "props",
        "children"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "type": {
          "const": "text"
        },
        "props": {
          "type": "object",
          "required": [
            "text"
          ],
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string",
              "maxLength": 5000
            },
            "align": {
              "$ref": "#/$defs/align"
            },
            "color": {
              "$ref": "#/$defs/colorRef",
              "default": {
                "token": "color-text"
              }
            },
            "size": {
              "$ref": "#/$defs/textSizeRef",
              "default": {
                "token": "text-md"
              }
            },
            "layerLabel": {
              "$ref": "#/$defs/layerLabel"
            },
            "bind": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "text": {
                  "$ref": "#/$defs/binding"
                }
              }
            }
          }
        },
        "children": {
          "$ref": "#/$defs/noChildren"
        }
      }
    },
    "rich-text": {
      "type": "object",
      "required": [
        "id",
        "type",
        "props",
        "children"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "type": {
          "const": "rich-text"
        },
        "props": {
          "type": "object",
          "required": [
            "content"
          ],
          "additionalProperties": false,
          "properties": {
            "content": {
              "$ref": "#/$defs/rtDoc"
            },
            "align": {
              "$ref": "#/$defs/align"
            },
            "color": {
              "$ref": "#/$defs/colorRef",
              "default": {
                "token": "color-text"
              }
            },
            "layerLabel": {
              "$ref": "#/$defs/layerLabel"
            },
            "bind": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "content": {
                  "$ref": "#/$defs/binding"
                }
              }
            }
          }
        },
        "children": {
          "$ref": "#/$defs/noChildren"
        }
      }
    },
    "image": {
      "type": "object",
      "required": [
        "id",
        "type",
        "props",
        "children"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "type": {
          "const": "image"
        },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "media": {
              "type": "object",
              "required": [
                "mediaId"
              ],
              "additionalProperties": false,
              "properties": {
                "mediaId": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "alt": {
              "type": "string",
              "maxLength": 300
            },
            "decorative": {
              "type": "boolean",
              "default": false
            },
            "width": {
              "enum": [
                "full",
                "natural"
              ],
              "default": "full"
            },
            "link": {
              "$ref": "#/$defs/link"
            },
            "layerLabel": {
              "$ref": "#/$defs/layerLabel"
            },
            "bind": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "media": {
                  "$ref": "#/$defs/binding"
                },
                "alt": {
                  "$ref": "#/$defs/binding"
                },
                "link": {
                  "$ref": "#/$defs/binding"
                }
              }
            }
          }
        },
        "children": {
          "$ref": "#/$defs/noChildren"
        }
      }
    },
    "button": {
      "type": "object",
      "required": [
        "id",
        "type",
        "props",
        "children"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "type": {
          "const": "button"
        },
        "props": {
          "type": "object",
          "required": [
            "label"
          ],
          "additionalProperties": false,
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "link": {
              "$ref": "#/$defs/link"
            },
            "style": {
              "enum": [
                "primary",
                "secondary",
                "outline"
              ],
              "default": "primary"
            },
            "align": {
              "$ref": "#/$defs/align"
            },
            "newTab": {
              "type": "boolean",
              "default": false
            },
            "layerLabel": {
              "$ref": "#/$defs/layerLabel"
            },
            "bind": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "label": {
                  "$ref": "#/$defs/binding"
                },
                "link": {
                  "$ref": "#/$defs/binding"
                }
              }
            }
          }
        },
        "children": {
          "$ref": "#/$defs/noChildren"
        }
      }
    },
    "spacer": {
      "type": "object",
      "required": [
        "id",
        "type",
        "props",
        "children"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "type": {
          "const": "spacer"
        },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "height": {
              "$ref": "#/$defs/spaceRef",
              "default": {
                "token": "space-lg"
              }
            },
            "layerLabel": {
              "$ref": "#/$defs/layerLabel"
            }
          }
        },
        "children": {
          "$ref": "#/$defs/noChildren"
        }
      }
    },
    "divider": {
      "type": "object",
      "required": [
        "id",
        "type",
        "props",
        "children"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "type": {
          "const": "divider"
        },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "color": {
              "$ref": "#/$defs/colorRef",
              "default": {
                "token": "color-border"
              }
            },
            "thickness": {
              "enum": [
                "thin",
                "thick"
              ],
              "default": "thin"
            },
            "spacing": {
              "$ref": "#/$defs/spaceRef",
              "default": {
                "token": "space-md"
              }
            },
            "layerLabel": {
              "$ref": "#/$defs/layerLabel"
            }
          }
        },
        "children": {
          "$ref": "#/$defs/noChildren"
        }
      }
    },
    "embed": {
      "type": "object",
      "required": [
        "id",
        "type",
        "props",
        "children"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "type": {
          "const": "embed"
        },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": {
              "type": "string",
              "maxLength": 2048,
              "pattern": "^https://((www\\.)?youtube\\.com/watch\\?v=[A-Za-z0-9_-]{11}(&[^\\u0000-\\u0020\\u007f]*)?|youtu\\.be/[A-Za-z0-9_-]{11}(\\?[^\\u0000-\\u0020\\u007f]*)?|(www\\.)?vimeo\\.com/[0-9]{1,12}(\\?[^\\u0000-\\u0020\\u007f]*)?)$"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "aspectRatio": {
              "enum": [
                "16:9",
                "4:3",
                "1:1"
              ],
              "default": "16:9"
            },
            "layerLabel": {
              "$ref": "#/$defs/layerLabel"
            }
          }
        },
        "children": {
          "$ref": "#/$defs/noChildren"
        }
      }
    },
    "navCollapse": {
      "description": "Hide the menu behind a menu button below one of the editor's preview widths: mobile (480 px) or tablet (767 px) (024 FR-017).",
      "type": "object",
      "required": [
        "enabled",
        "below"
      ],
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "below": {
          "enum": [
            "mobile",
            "tablet"
          ]
        },
        "buttonLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[^\u0000-\u001f]*$"
        }
      }
    },
    "navigation": {
      "description": "Shows one of the site's menus (024, docs/contracts/menu.md). menuId may name a menu that no longer exists; publishing refuses it.",
      "type": "object",
      "required": [
        "id",
        "type",
        "props",
        "children"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "type": {
          "const": "navigation"
        },
        "props": {
          "type": "object",
          "required": [
            "menuId"
          ],
          "additionalProperties": false,
          "properties": {
            "menuId": {
              "type": "string",
              "format": "uuid"
            },
            "layout": {
              "enum": [
                "horizontal",
                "vertical"
              ],
              "default": "horizontal"
            },
            "levels": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3,
              "default": 3
            },
            "collapse": {
              "$ref": "#/$defs/navCollapse",
              "default": {
                "enabled": false,
                "below": "mobile"
              }
            },
            "align": {
              "$ref": "#/$defs/align"
            },
            "ariaLabel": {
              "description": "The navigation landmark's accessible name; absent: the live menu's name.",
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[^\u0000-\u001f]*$"
            },
            "look": {
              "description": "How top-level entries look; absent: the site's menu style (024 FR-017b).",
              "enum": [
                "link",
                "underline",
                "pill",
                "button"
              ]
            },
            "color": {
              "$ref": "#/$defs/colorRef",
              "description": "Entry text; absent: the site's menu style (024 FR-017c)."
            },
            "activeColor": {
              "$ref": "#/$defs/colorRef",
              "description": "Current, containing and section entries' text; absent: the site's menu style."
            },
            "background": {
              "$ref": "#/$defs/colorRef",
              "description": "The bar's background; absent: the site's menu style."
            },
            "hoverColor": {
              "$ref": "#/$defs/colorRef",
              "description": "Entry text on hover; absent: the site's menu style."
            },
            "hoverBackground": {
              "$ref": "#/$defs/colorRef",
              "description": "Entry background on hover; absent: the site's menu style."
            },
            "activeBackground": {
              "$ref": "#/$defs/colorRef",
              "description": "The current entry's background; absent: the site's menu style."
            },
            "focusColor": {
              "$ref": "#/$defs/colorRef",
              "description": "The keyboard focus ring, which cannot be turned off; absent: the current entry's text colour, then the site's menu style (024 FR-017d)."
            },
            "panelBackground": {
              "$ref": "#/$defs/colorRef",
              "description": "Horizontal dropdowns and the opened small-screen panel; absent: the site's menu style."
            },
            "layerLabel": {
              "$ref": "#/$defs/layerLabel"
            }
          }
        },
        "children": {
          "$ref": "#/$defs/noChildren"
        }
      }
    },
    "fieldId": {
      "description": "A collection field, by its stable id (collection-schema.md §2).",
      "type": "string",
      "pattern": "^f[1-9][0-9]{0,5}$"
    },
    "builtInValue": {
      "description": "An item value that is not a field (binding-expression.md §2).",
      "enum": [
        "url",
        "slug",
        "firstPublishedAt",
        "lastPublishedAt"
      ]
    },
    "itemOrderValue": {
      "description": "The built-in item values a list can filter and sort on (binding-expression.md §5).",
      "enum": [
        "slug",
        "firstPublishedAt",
        "lastPublishedAt"
      ]
    },
    "valueFormat": {
      "description": "How a date, number or boolean is shown. A format that does not fit the value is ignored.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "date": {
          "enum": [
            "short",
            "medium",
            "long",
            "iso"
          ]
        },
        "number": {
          "type": "object",
          "required": [
            "decimals"
          ],
          "additionalProperties": false,
          "properties": {
            "decimals": {
              "type": "integer",
              "minimum": 0,
              "maximum": 6
            }
          }
        },
        "yes": {
          "type": "string",
          "maxLength": 100
        },
        "no": {
          "type": "string",
          "maxLength": 100
        }
      }
    },
    "bindingPart": {
      "description": "A part of a text template: fixed text, or a value with exactly one of field and item (checked in code).",
      "type": [
        "string",
        "object"
      ],
      "maxLength": 500,
      "additionalProperties": false,
      "properties": {
        "field": {
          "$ref": "#/$defs/fieldId"
        },
        "item": {
          "$ref": "#/$defs/builtInValue"
        },
        "via": {
          "$ref": "#/$defs/fieldId"
        },
        "scope": {
          "$ref": "#/$defs/nodeId"
        },
        "format": {
          "$ref": "#/$defs/valueFormat"
        }
      }
    },
    "bindingSource": {
      "description": "What a binding reads: exactly one of field, item and parts (checked in code; binding-expression.md §2).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "field": {
          "$ref": "#/$defs/fieldId"
        },
        "item": {
          "$ref": "#/$defs/builtInValue"
        },
        "via": {
          "$ref": "#/$defs/fieldId"
        },
        "scope": {
          "$ref": "#/$defs/nodeId"
        },
        "format": {
          "$ref": "#/$defs/valueFormat"
        },
        "parts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/bindingPart"
          }
        }
      }
    },
    "binding": {
      "description": "Fills one block property from an item (binding-expression.md §2). The value holds exactly one of field, item and parts (checked in code).",
      "type": "object",
      "required": [
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "$ref": "#/$defs/bindingSource"
        },
        "empty": {
          "enum": [
            "fallback",
            "hide"
          ],
          "default": "fallback"
        }
      }
    },
    "listSource": {
      "description": "A collection of the site, or a multi-reference field of a scope's item; exactly one of collectionId and field (checked in code).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "collectionId": {
          "type": "string",
          "format": "uuid"
        },
        "field": {
          "$ref": "#/$defs/fieldId"
        },
        "scope": {
          "$ref": "#/$defs/nodeId"
        }
      }
    },
    "listOperand": {
      "description": "A filter's value: a literal, a field of an enclosing scope's item, or the current item (binding-expression.md §5).",
      "type": [
        "string",
        "number",
        "boolean",
        "object"
      ],
      "maxLength": 500,
      "additionalProperties": false,
      "properties": {
        "field": {
          "$ref": "#/$defs/fieldId"
        },
        "scope": {
          "$ref": "#/$defs/nodeId"
        },
        "current": {
          "const": true
        }
      }
    },
    "listFilter": {
      "description": "One condition; exactly one of field and item (checked in code).",
      "type": "object",
      "required": [
        "op"
      ],
      "additionalProperties": false,
      "properties": {
        "field": {
          "$ref": "#/$defs/fieldId"
        },
        "item": {
          "$ref": "#/$defs/itemOrderValue"
        },
        "op": {
          "enum": [
            "eq",
            "ne",
            "contains",
            "gt",
            "lt",
            "empty",
            "notEmpty"
          ]
        },
        "value": {
          "$ref": "#/$defs/listOperand"
        }
      }
    },
    "listSort": {
      "description": "One sort key; exactly one of field and item (checked in code).",
      "type": "object",
      "required": [
        "dir"
      ],
      "additionalProperties": false,
      "properties": {
        "field": {
          "$ref": "#/$defs/fieldId"
        },
        "item": {
          "$ref": "#/$defs/itemOrderValue"
        },
        "dir": {
          "enum": [
            "asc",
            "desc"
          ]
        }
      }
    },
    "listPaging": {
      "type": "object",
      "required": [
        "pageSize"
      ],
      "additionalProperties": false,
      "properties": {
        "pageSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "param": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "default": "page"
        },
        "layout": {
          "type": "string",
          "enum": [
            "numbers",
            "steps"
          ],
          "default": "numbers"
        }
      }
    },
    "collection-list": {
      "type": "object",
      "required": [
        "id",
        "type",
        "props",
        "children"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "type": {
          "const": "collection-list"
        },
        "props": {
          "type": "object",
          "required": [
            "source"
          ],
          "additionalProperties": false,
          "properties": {
            "source": {
              "$ref": "#/$defs/listSource"
            },
            "filters": {
              "type": "array",
              "maxItems": 10,
              "items": {
                "$ref": "#/$defs/listFilter"
              }
            },
            "sort": {
              "type": "array",
              "maxItems": 3,
              "items": {
                "$ref": "#/$defs/listSort"
              }
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 12
            },
            "paging": {
              "$ref": "#/$defs/listPaging"
            },
            "columns": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4,
              "default": 3
            },
            "gap": {
              "$ref": "#/$defs/spaceRef",
              "default": {
                "token": "space-md"
              }
            },
            "layerLabel": {
              "$ref": "#/$defs/layerLabel"
            }
          }
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/listChild"
          }
        }
      }
    },
    "list-card": {
      "description": "Repeated once per listed item; its blocks bind to that item (scope named by the list's id).",
      "type": "object",
      "required": [
        "id",
        "type",
        "props",
        "children"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "type": {
          "const": "list-card"
        },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "layerLabel": {
              "$ref": "#/$defs/layerLabel"
            }
          }
        },
        "children": {
          "$ref": "#/$defs/contentChildren"
        }
      }
    },
    "list-empty": {
      "description": "Shown instead of cards when the list has no item to show.",
      "type": "object",
      "required": [
        "id",
        "type",
        "props",
        "children"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "type": {
          "const": "list-empty"
        },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "layerLabel": {
              "$ref": "#/$defs/layerLabel"
            }
          }
        },
        "children": {
          "$ref": "#/$defs/contentChildren"
        }
      }
    },
    "rtDoc": {
